# ============================================================
# VELVET STEEL BARBERSHOP — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.
# ============================================================


# ── DJANGO CORE ──────────────────────────────────────────────

# A long random string used to sign cookies and tokens.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-change-this-in-production

# Set to True for local development. Always False in production.
# When False, Django won't show error details to users.
DEBUG=True

# Comma-separated list of allowed hostnames. No spaces.
# Example for production: myapp.vercel.app,mysite.com
ALLOWED_HOSTS=localhost,127.0.0.1


# ── DATABASE ─────────────────────────────────────────────────

# Your MongoDB connection string.
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017


# ── EMAIL ─────────────────────────────────────────────────────

# Which email backend Django uses.
# Development — prints emails to the terminal, no actual sending:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production — sends real emails via SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP settings.
# For EMAIL_HOST_PASSWORD, create an App Password at:
#   https://myaccount.google.com/apppasswords
# Do NOT use your regular Gmail password — it won't work and is a security risk.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=Velvet Steel Barbershop <noreply@yourdomain.com>


# ── BARBERSHOP INFO ──────────────────────────────────────────

# These appear in metadata and fallback text across the site.
# Most visible content is managed through the admin panel.
BARBERSHOP_NAME=Velvet Steel Barbershop
BARBERSHOP_PHONE=+63 912 345 6789
BARBERSHOP_ADDRESS=123 Rizal Avenue, Quezon City, Metro Manila
BARBERSHOP_EMAIL=info@velvetsteel.ph


# ── ADMIN SEED ───────────────────────────────────────────────

# Used only when running: python manage.py seed_data
# If left unset, a random password is generated and printed once to the console.
# ADMIN_SEED_PASSWORD=your-secure-admin-password


# ── PRODUCTION ONLY ──────────────────────────────────────────

# Uncomment these when deploying to HTTPS.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# If your domain isn't localhost or *.vercel.app, add it here too.
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Vercel sets its own admin user on cold start using these.
# Set them in your Vercel project environment variables, not here.
# DJANGO_ADMIN_USER=admin
# DJANGO_ADMIN_EMAIL=admin@yourdomain.com
# DJANGO_ADMIN_PASSWORD=your-secure-password
